{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": [
    "./src/lib/validation.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test tests",
    "test:coverage": "bun test tests --coverage --coverage-reporter=text --coverage-reporter=lcov && bun scripts/report-coverage.ts",
    "typecheck": "tsc --noEmit",
    "preview:cloudflare": "wrangler dev --config .output/server/wrangler.json",
    "deploy": "wrangler deploy --config .output/server/wrangler.json",
    "deploy:check": "wrangler deploy --dry-run --config .output/server/wrangler.json",
    "security:audit": "bun audit",
    "migrations:check": "bun scripts/check-migrations.ts",
    "i18n:check": "bun scripts/check-translations.ts",
    "i18n:export": "bun scripts/export-translation-seed.ts",
    "i18n:audit": "bun scripts/check-translations.ts --live",
    "i18n:audit:database": "bun scripts/check-translations.ts --live --database",
    "images:check": "bun scripts/check-images.ts",
    "images:audit": "bun scripts/check-images.ts --remote",
    "images:cache": "bun scripts/update-image-cache.ts",
    "images:cache:apply": "bun scripts/update-image-cache.ts --apply",
    "test:mobile": "bun run test:mobile:iphone && bun run test:mobile:android",
    "test:mobile:install": "node node_modules/@playwright/test/cli.js install --with-deps webkit chromium",
    "migrations:test": "bun scripts/test-migrations.ts",
    "build:coverage": "HUB_BROWSER_COVERAGE=1 vite build",
    "test:mobile:coverage": "bun -e 'require(\"node:fs\").rmSync(\"coverage/browser\", { recursive: true, force: true })' && bun run build:coverage && HUB_BROWSER_COVERAGE=1 bun run test:mobile && bun scripts/report-browser-coverage.ts",
    "coverage:check-production": "bun scripts/check-production-coverage.ts",
    "test:mobile:iphone": "HUB_TEST_PROJECT=iphone-webkit node node_modules/@playwright/test/cli.js test --project=iphone-webkit",
    "test:mobile:android": "HUB_TEST_PROJECT=android-chrome node node_modules/@playwright/test/cli.js test --project=android-chrome",
    "images:variants": "bun scripts/prepare-bucket-images.ts"
  },
  "overrides": {
    "launch-editor": "2.14.2",
    "source-map-js": "1.2.2",
    "rolldown": "1.2.1",
    "undici": "7.30.1",
    "sharp": "0.35.5",
    "js-yaml": "4.3.2",
    "seroval": "1.6.11",
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.5",
    "@lovable.dev/vite-tanstack-config": "^2.24.0",
    "@playwright/test": "^1.63.0",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-lib-source-maps": "4.0.4",
    "@types/istanbul-reports": "3.0.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-lib-source-maps": "5.0.6",
    "istanbul-reports": "3.2.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.9.8",
    "sharp": "0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.1.6",
    "vite-plugin-istanbul": "9.0.1",
    "wrangler": "4.135.0"
  }
}
