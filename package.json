{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "preview:cloudflare": "wrangler dev --config .output/server/wrangler.json",
    "deploy": "wrangler deploy --config .output/server/wrangler.json",
    "deploy:check": "wrangler deploy --dry-run --config .output/server/wrangler.json",
    "security:audit": "bun audit",
    "i18n:check": "bun scripts/check-translations.ts",
    "i18n:export": "bun scripts/export-translation-seed.ts",
    "i18n:audit": "bun scripts/check-translations.ts --live",
    "i18n:audit:database": "bun scripts/check-translations.ts --live --database",
    "images:check": "bun scripts/check-images.ts",
    "images:audit": "bun scripts/check-images.ts --remote",
    "images:cache": "bun scripts/update-image-cache.ts",
    "images:cache:apply": "bun scripts/update-image-cache.ts --apply"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lovable.dev/vite-tanstack-config": "^2.24.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.1.5",
    "wrangler": "4.135.0"
  }
